[Unit]
Description=Electrum Lite private beta (%i)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/electrum-lite/%i.env
ExecStart=%h/.cargo/bin/electrum-lite --network %i --data-dir %h/.local/share/electrum-lite serve --cookie-file ${CORE_COOKIE} --rpc-url ${CORE_RPC} --listen ${ELECTRUM_LISTEN}
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
NoNewPrivileges=yes
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=default.target
